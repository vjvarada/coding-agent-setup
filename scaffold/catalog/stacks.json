{
  "_doc": "Starting recipes for common stacks. The scaffolder copies the commands into AGENTS.md, the run-and-verify skill and CI. `init` commands are run by the AGENT (SCAFFOLD.md step 3), never by the script: generators change their flags, so check `<tool> --help` first and adapt. {slug} and {module} are replaced with the project's names. Any field can be overridden in the intake; an unknown stack is fine — give the fields yourself with id 'custom'.",
  "stacks": {
    "nextjs": {
      "title": "Next.js (TypeScript, App Router) + pnpm",
      "language": "TypeScript",
      "init": ["pnpm create next-app@latest . --ts --eslint --app --src-dir --use-pnpm", "pnpm add -D vitest"],
      "install": "pnpm install",
      "dev": "pnpm dev",
      "test": "pnpm exec vitest run",
      "lint": "pnpm lint",
      "typecheck": "pnpm exec tsc --noEmit",
      "build": "pnpm build",
      "ci": "pnpm",
      "gitignore": ["node_modules/", ".next/", "coverage/"],
      "graphifyignore": [".next/**", "*.min.js", "*.min.mjs"]
    },
    "vite-react": {
      "title": "Vite + React (TypeScript) + pnpm",
