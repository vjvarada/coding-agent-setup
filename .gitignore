# Nothing here should be committed by consumers, but if this kit is used in-place:
# (upstream recommends committing graphify-out/ in real repos; not in this kit)
graphify-out/
/.graphifyignore
*.log

# OS / editor cruft
.DS_Store
Thumbs.db

# Skill runtime cruft (must never be published). Root-anchored on purpose: an
# unanchored `.claude/` would also drop templates/project/.claude/ from the kit.
/.impeccable/
/.claude/

# Python caches from running the kit tests
__pycache__/
*.py[cod]
